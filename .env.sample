# ─────────────────────────────────────────────────────────────────────────────
# .env.sample — credentials for the promptfoo cyber capability + defense evals.
#
# Copy to `.env` at the repo root:  cp .env.sample .env
# then fill in only the keys for the providers you actually use.
# `.env` is gitignored — never commit real keys. promptfoo auto-loads this file,
# and the cyber runners (F2, defense twin, Cybench) read it as the single source.
#
# Pick the target model's endpoint with CYBER_SUT_ENDPOINT (+ CYBER_MODEL), e.g.:
#   CYBER_SUT_ENDPOINT=openai    CYBER_MODEL=openai/gpt-5
#   CYBER_SUT_ENDPOINT=anthropic CYBER_MODEL=anthropic/claude-sonnet-4-5
#   CYBER_SUT_ENDPOINT=engy      CYBER_MODEL=openai/glm-5.3
#   CYBER_SUT_ENDPOINT=azure     CYBER_MODEL=openai/DeepSeek-V4-Flash
# ─────────────────────────────────────────────────────────────────────────────

# --- Real provider APIs (inspect_ai native providers) ---
OPENAI_API_KEY=            # CYBER_SUT_ENDPOINT=openai     · CYBER_MODEL=openai/<name>     (api.openai.com)
ANTHROPIC_API_KEY=         # CYBER_SUT_ENDPOINT=anthropic  · CYBER_MODEL=anthropic/<name>  (api.anthropic.com)

# --- Hosted OpenAI-compatible gateways ---
ENGY_API_KEY=              # CYBER_SUT_ENDPOINT=engy       · api.engy.ai/v1        (GLM-5.2 / GLM-5.3 / ...)
CHUTES_API_KEY=            # CYBER_SUT_ENDPOINT=chutes     · llm.chutes.ai         (any Chutes model, incl. -TEE)
HALO_AZURE_AI_API_KEY=     # CYBER_SUT_ENDPOINT=azure      · halo-dataline Azure Foundry (DeepSeek-V4-Flash / ...)

# --- Cybench x86 runner (run_cybench_x86.sh): model endpoint + egress-lockdown target ---
# The runner locks host egress to AZURE_AI_BASE_URL's host, so set it to the OpenAI-compatible
# endpoint you run Cybench against. Override either inline for a one-off endpoint.
AZURE_AI_BASE_URL=         # e.g. https://api.engy.ai/v1   or   https://api.openai.com/v1
AZURE_AI_API_KEY=          # the key for AZURE_AI_BASE_URL

# --- One-off / custom endpoint (no registry entry needed) ---
# CYBER_BASE_URL=https://your-endpoint/v1        # sets OPENAI_BASE_URL for the run
# CYBER_API_KEY_ENV=NAME_OF_THE_ENV_VAR          # name of the env var holding that endpoint's key

# --- Optional: self-hosted vLLM ("local" endpoint; CAISI's vendored .env drives the URL) ---
# LOCAL_AI_API_KEY=

# --- Optional: promptfoo cloud (sharing / hosted view) ---
# PROMPTFOO_API_KEY=
