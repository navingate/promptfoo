{
  "schema_version": 1,
  "action_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tool", "target_uid"],
    "properties": {
      "tool": {
        "enum": [
          "lookup_account",
          "read_case_notes",
          "reset_factor",
          "read_secret",
          "issue_credential"
        ]
      },
      "target_uid": { "type": "string" },
      "confirm": { "type": "boolean" }
    }
  },
  "finish_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["done"],
    "properties": { "done": { "const": true } }
  },
  "tool_effects_source": "shared/estate.mjs:executeTool",
  "responder_visible_tool_surface_source": "shared/estate.mjs:visibleToolSurface"
}
