# Single source of truth for the L3 capability-run slice.
# Sourced by setup_caisi.sh, run_cybench.sh, and list_samples.sh.

# --- Vendored harness (cloned locally, never committed) ---
CAISI_REPO="https://github.com/usnistgov/caisi-cyber-evals.git"
CAISI_DIR="$SCRIPT_DIR/vendor/caisi-cyber-evals"

# --- The three chosen Cybench tasks: one web, one crypto, one misc. ---
# All are Ghidra-free (no reverse-engineering), so the heavy GaaS container is
# NOT needed. dynastic uses an alpine stub target (no image build required);
# flag_command and unbreakable build one small target image each.
#   flag_command  -> web    (eval.yml name: "flag-command")
#   dynastic      -> crypto  (blank/alpine target)
#   unbreakable   -> misc
TASKS="flag_command dynastic unbreakable"
# Tasks that need a target image built (dynastic's target is the alpine stub):
TASKS_NEEDING_BUILD="flag_command unbreakable"
# Sample identifiers passed to `-T samples=...`. Resolve the exact tokens with
# list_samples.sh — inspect_cyber's eval_name may use the eval.yml `name`
# (e.g. "flag-command" with a hyphen) rather than the directory name. Default
# to the directory names; list_samples.sh prints the authoritative list.
SAMPLES="flag_command,dynastic,unbreakable"

# --- Default model under test (override with CYBER_SUT_ENDPOINT + CYBER_MODEL) ---
# CYBER_SUT_ENDPOINT=<name> (engy/chutes/azure/openai/anthropic) + CYBER_MODEL=<id> select a registered
# endpoint from provider.py's SUT_ENDPOINTS — the uniform interface run_cybench.sh now honors, same as F2.
# Unset → this local self-hosted Qwen (vLLM, OpenAI-compatible); its endpoint URL + key then come from the
# creds (AZURE_AI_BASE_URL/AZURE_AI_API_KEY) written into the harness .env by setup_caisi.sh.
INSPECT_MODEL="openai/llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-GPTQ-Int4"

# Token budget per task — keep small for the slice.
TOKEN_LIMIT="200000"
# Wall-clock guard for the whole eval so a stalled endpoint can't hang forever.
EVAL_TIMEOUT_SECS="1800"

# --- Credentials source (never hardcode secrets) ---
# Creds come from the consolidated repo-root .env (AZURE_AI_BASE_URL/AZURE_AI_API_KEY). Override
# HALO_ENV to point elsewhere. We map AZURE_AI_* -> OPENAI_* for Inspect's openai provider.
HALO_ENV="${HALO_ENV:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)/.env}"

# Core agent image tag CAISI expects (from ucb/cli.py AGENT_NAME).
AGENT_IMAGE="agent-environment:1.1.1"
