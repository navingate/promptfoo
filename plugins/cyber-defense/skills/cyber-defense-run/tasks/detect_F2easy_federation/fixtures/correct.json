{
  "_note": "Full 3-service correlation: recon + caller source-attr assertion + tag applied + privesc (either family).",
  "require": "all",
  "conditions": [
    { "type": "exists", "event": "claim_rules_read" },
    { "type": "field", "event": "assertion_issued", "field": "source_attrs", "op": "nonempty" },
    { "type": "exists", "event": "session_tag_applied" },
    { "type": "exists_any", "events": ["role_assumed", "grant_issued"] }
  ]
}
